{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["dist", "dist.next", "dist.old", "vendor"],
  "overrides": [
    {
      "files": ["test/legacy/**"],
      "rules": {
        "unicorn/no-array-sort": "off",
        "no-shadow": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-array-reverse": "off"
      }
    },
    {
      "files": ["src/features/title-translation/method/**"],
      "rules": {
        "unicorn/no-array-sort": "off",
        "unicorn/prefer-string-starts-ends-with": "off",
        "no-misleading-character-class": "off",
        "unicorn/consistent-function-scoping": "off",
        "no-shadow": "off",
        "no-control-regex": "off",
        "no-useless-escape": "off",
        "vitest/no-commented-out-tests": "off"
      }
    },
    {
      "files": [
        "src/shared/kit/layout.ts",
        "src/shared/kit/vacancy-page.ts",
        "src/features/job-portals/page-layouts.ts",
        "src/shared/kit/sentences.ts",
        "src/shared/words/index.ts",
        "src/shared/words/stance.ts",
        "src/shared/words/tables/**",
        "src/features/advert-facts/contract.ts",
        "src/features/advert-facts/work-mode.ts",
        "src/features/advert-facts/work-modes.ts",
        "src/features/advert-facts/years.ts",
        "src/features/advert-facts/screens.ts",
        "src/features/advert-facts/labels.ts",
        "src/features/pay/pay.ts",
        "src/features/pay/text-pay.ts"
      ],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "no-shadow": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/prefer-string-starts-ends-with": "off",
        "unicorn/no-useless-fallback-in-spread": "off",
        "unicorn/no-useless-spread": "off"
      }
    }
  ]
}
