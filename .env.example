# Port the API listens on.
PORT=4000
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Scrapper credentials (FR-9): one variable per credentialed source, each left empty here.
# A source whose variables are missing stays disabled and the status names them.
# Real values go only in .env, which git ignores.

# NAV's job feed for Norway (nav): a free token NAV sends by e-mail once its terms are accepted
# (arbeidsplassen.nav.no/vilkar-api; write to nav.team.arbeidsplassen@nav.no).
NAV_TOKEN=

# Jooble's partner API (jooble), free for partner sites (jooble.org/api/about): one key for every
# country, or one per country as "es=KEY1,de=KEY2". Either switches the source on.
JOOBLE_KEY=
JOOBLE_KEYS=

# The partner programmes' XML feeds (talentcom, whatjobs, jobtome): the address each programme gives
# once signed up (employers.talent.com/publishers, whatjobs.com/affiliates, jobtome.com). Secret.
TALENTCOM_FEED_URL=
WHATJOBS_FEED_URL=
JOBTOME_FEED_URL=

# Adzuna's API (adzuna), a registered app at developer.adzuna.com. Flagged off whatever is set here:
# its terms ask a licence agreement for a site with ads, and api.adzuna.com's robots.txt closes it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Where the scrapper keeps its store (adverts, source state, the STOP flag).
# Default: store/ at the repo root.
# STORE_DIR=

# Where the processor keeps what it remembers between runs (the directory, the pile's history).
# Default: state/ at the repo root.
# PROCESSOR_STATE_DIR=

# Where the processor writes the published dataset: one folder per version and current.json, the
# version the API serves. Default: published/ at the repo root.
# PUBLISHED_DIR=

# The title translator's engine and models, fetched by `pnpm translate:fetch`. Default: state/mt/.
# MT_DIR=
# Projecte Aina's Spanish-Catalan model and its Python (optional). Default: ~/mt-aina.
# AINA_DIR=

# The server's operations (features/012-operations, ops/README.md).
# The ntfy.sh channel the operator's phone subscribes to: a long random name, kept secret. Empty: notices
# are only written to the alerts' log.
NTFY_TOPIC=
# The private repository whose release "server-backup" holds the nightly copies (owner/name; it needs one
# commit). Empty: the backup fails, and the operator hears of it.
BACKUP_REPO=
# Where the operations keep their logs, locks and the problems told. Default: var/ at the repo root.
# OPS_DIR=
