# Port the API listens on.
PORT=4000
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Scrapper credentials (FR-9): one variable per credentialed source, each left empty here.
# A source whose variables are missing stays disabled and the status names them.
# Real values go only in .env, which git ignores.

# Where the scrapper keeps its store (adverts, source state, the STOP flag).
# Default: store/ at the repo root.
# STORE_DIR=
